from PIL import Image, ImageDraw
import colorsys

# Create image
img = Image.new('RGBA', (180, 180), color=(10, 10, 10, 255))
draw = ImageDraw.Draw(img)

# Draw gradient background
for i in range(180):
    hue = 0.78  # Purple hue
    sat = 0.80
    val = 0.65 - (i / 180) * 0.15
    rgb = colorsys.hsv_to_rgb(hue, sat, val)
    rgb = tuple(int(c * 255) for c in rgb) + (255,)
    draw.line([(0, i), (180, i)], fill=rgb)

# Draw white H
padding = 30
bar_width = 20
h_x1 = padding
h_x2 = padding + bar_width
h_x3 = 180 - padding - bar_width
h_x4 = 180 - padding
h_y1 = padding
h_y2 = 90 - 5
h_y3 = 90 + 5
h_y4 = 180 - padding

white = (255, 255, 255, 255)

# Left bar
draw.rectangle([h_x1, h_y1, h_x2, h_y4], fill=white)
# Right bar
draw.rectangle([h_x3, h_y1, h_x4, h_y4], fill=white)
# Middle bar
draw.rectangle([h_x1 + 15, h_y2, h_x4 - 15, h_y3], fill=(199, 125, 255, 255))

img.save('favicon-180.png')
